NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_...

# Neon DB — get from console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# NextAuth — run: openssl rand -base64 32
AUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# One-time seed endpoint secret — remove after seeding
SEED_SECRET=any-secret-string-you-choose

# Initial superadmin credentials for scripts/setup-db.mjs & scripts/seed-superadmin.mjs
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-strong-password
